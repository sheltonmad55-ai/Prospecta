# Modo: 'live' para produção com Supabase e IA Gemini.
PROSPECTA_MODE=live
PROSPECTA_DB_PATH=./data/prospecta.sqlite
APP_URL=https://prospecta-mz.vercel.app

# Supabase Auth e Backend
SUPABASE_URL=
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini AI (Análise de empresas e scripts de vendas)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Opcional: Provedor de busca Serper Google Maps (fallback automático para OpenStreetMap se vazio)
SERPER_API_KEY=

# Microserviço de WhatsApp dedicado (Render / Oracle Cloud / Docker)
# URL onde o contentor node whatsapp-service está hospedado
WHATSAPP_SERVICE_URL=https://prospecta-whatsapp.onrender.com
# Chave secreta de autenticação (deve ser uma chave forte aleatória em produção)
WHATSAPP_SERVICE_KEY=

# Módulo Criar Site (Prospecta Lovable-Style)
# Módulo Criar Site (Prospecta Edição Assistida)
# Chaves Google Gemini AI (Geração de sites, streaming e motor de operações)
SITE_AI_API_KEY=
SITE_AI_API_KEY_2=
SITE_AI_MODEL=gemini-flash-lite-latest
SITE_AI_MODEL_EDIT=gemini-flash-lite-latest

