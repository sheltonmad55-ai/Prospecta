# Demo local: contas e SQLite persistentes. Não publique este modo na internet.
PROSPECTA_MODE=demo
PROSPECTA_DB_PATH=./data/prospecta.sqlite
APP_URL=http://127.0.0.1:4317
# Live: autenticação Supabase e IA Gemini. Siga docs/OPERATIONS.md antes de publicar.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Google: active o fornecedor em Supabase Auth. Client ID/Secret ficam no Supabase.
# Autorize APP_URL/api/auth/callback nas Redirect URLs do Supabase.
# Consulte docs/GOOGLE_AUTH.md; modo demo nunca simula um login Google.
GEMINI_API_KEY=
GEMINI_MODEL=
# Dataset normalizado segundo docs/API.md, com direitos de utilização confirmados.
APIFY_TOKEN=
APIFY_DATASET_ID=
APIFY_DATA_RIGHTS_CONFIRMED=false
