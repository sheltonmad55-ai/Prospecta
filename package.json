{
  "name": "prospecta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "worker": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/worker.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:api": "node scripts/api-smoke.mjs",
    "test:dom": "node --experimental-strip-types scripts/dom-smoke.mjs",
    "test:landing": "node --experimental-strip-types scripts/landing-smoke.mjs",
    "test:auth": "node --experimental-strip-types scripts/auth-screen-smoke.mjs",
    "test:auth-api": "node scripts/auth-api-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.57.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "happy-dom": "21.0.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
