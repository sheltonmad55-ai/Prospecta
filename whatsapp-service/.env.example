# Porta do servidor
PORT=3001

# Chave secreta de autenticação entre a Prospecta (Vercel) e este microserviço
# Use um token longo gerado aleatoriamente (ex: openssl rand -hex 32)
API_KEY=sua_chave_secreta_prospecta_whatsapp_2026

# Origem permitida para CORS (URL da Prospecta na Vercel ou '*' para todas)
ALLOWED_ORIGIN=https://prospecta-mz.vercel.app

# Credenciais do Supabase (para persistir sessões do Baileys e campanhas)
SUPABASE_URL=https://exemplo.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# Fuso horário para protecção de horários de envio
TZ=Africa/Maputo
